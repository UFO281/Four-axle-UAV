  19          /*Declare SFR associated with the PCA */
  20          sfr CCON        =   0xD8;           //PCA control register
  21          sbit CCF0       =   CCON^0;         //PCA module-0 interrupt flag
  22          sbit CCF1       =   CCON^1;         //PCA module-1 interrupt flag
  23          sbit CR         =   CCON^6;         //PCA timer run control bit
  24          sbit CF         =   CCON^7;         //PCA timer overflow flag
  25          sfr CMOD        =   0xD9;           //PCA mode register
  26          sfr CL          =   0xE9;           //PCA base timer LOW
  27          sfr CH          =   0xF9;           //PCA base timer HIGH
  28          sfr CCAPM0      =   0xDA;           //PCA module-0 mode register
  29          sfr CCAP0L      =   0xEA;           //PCA module-0 capture register LOW
  30          sfr CCAP0H      =   0xFA;           //PCA module-0 capture register HIGH
  31          sfr CCAPM1      =   0xDB;           //PCA module-1 mode register
  32          sfr CCAP1L      =   0xEB;           //PCA module-1 capture register LOW
  33          sfr CCAP1H      =   0xFB;           //PCA module-1 capture register HIGH
  34          sfr PCAPWM0     =   0xf2;
  35          sfr PCAPWM1     =   0xf3;
  36          
  37          
  38          void pwm_init(void)
  39          {
  40   1          CCON = 0;                       //Initial PCA control register
  41   1                                          //PCA timer stop running
  42   1                                          //Clear CF flag
  43   1                                          //Clear all module interrupt flag
  44   1          CL = 0;                         //Reset PCA base timer
  45   1          CH = 0;
  46   1          CMOD = 0x02;                    //Set PCA timer clock source as Fosc/2
  47   1                                          //Disable PCA timer overflow interrupt
  48   1          CCAP0H = CCAP0L = 0x80;         //PWM0 port output 50% duty cycle square wave
  49   1          CCAPM0 = 0x42;                  //PCA module-0 work in 8-bit PWM mode and no PCA interrupt
  50   1      
  51   1          CCAP1H = CCAP1L = 0xff;         //PWM1 port output 0% duty cycle square wave
  52   1          PCAPWM1 = 0x03;
  53   1          CCAPM1 = 0x42;                  //PCA module-1 work in 8-bit PWM mode and no PCA interrupt
