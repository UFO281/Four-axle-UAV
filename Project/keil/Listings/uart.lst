  59          void Uart_Isr() interrupt 4
  60          {
  61   1          if (RI)
  62   1          {
  63   2              RI = 0;             //Clear receive interrupt flag
  64   2              P0 = SBUF;          //P0 show UART data
  65   2              bit9 = RB8;         //P2.2 show parity bit
  66   2          }
  67   1          if (TI)
  68   1          {
  69   2              TI = 0;             //Clear transmit interrupt flag
  70   2              busy = 0;           //Clear transmit busy flag
  71   2          }
  72   1      }
